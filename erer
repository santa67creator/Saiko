def listen():
    """Слушает микрофон и возвращает текст"""
    r = sr.Recognizer()
    with sr.Microphone() as source:
        print("\nСлушаю... (говорите)")
        r.adjust_for_ambient_noise(source, duration=0.5) # Калибровка шума
        try:
            audio = r.listen(source, timeout=5, phrase_time_limit=10)
            # Примечание: recognize_google требует интернета, но это самый простой способ начать.
            # Для полного оффлайна нужно использовать Vosk или Whisper (см. ниже).
            query = r.recognize_google(audio, language="ru-RU")
            print(f"Вы сказали: {query}")
            return query.lower()
        except sr.UnknownValueError:
            return None
        except sr.RequestError:
            speak("Ошибка сервиса распознавания.")
            return None
        except Exception as e:
            return None